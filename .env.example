# --- Serveur ---
PORT=3000
BASE_URL=http://localhost:3000

# --- Google OAuth (console.cloud.google.com > Credentials > OAuth client "Web application") ---
# URI de redirection à déclarer : http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Moteur de recherche pour la prospection LinkedIn (optionnel) ---
# Sans clé, l'app utilise le scraping de moteurs publics (Yahoo, Ecosia…) : gratuit
# mais moins fiable. Renseigner UNE de ces options fiabilise nettement la recherche.
# 1) Google Programmable Search (officiel) : 100 requêtes/jour gratuites.
#    Clé : console.cloud.google.com > API "Custom Search API" > Credentials.
#    CX  : programmablesearchengine.google.com (créer un moteur "tout le Web").
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# 2) Serper.dev : résultats Google, 2 500 requêtes offertes puis ~1 $/1000.
SERPER_API_KEY=
# 3) Brave Search API : 2 000 requêtes/mois gratuites.
BRAVE_SEARCH_API_KEY=

# --- Attio (bonus, optionnel) ---
ATTIO_API_KEY=
ATTIO_STAGE_ATTRIBUTE=

# --- Délivrabilité ---
# Quota d'envoi quotidien par défaut pour chaque compte connecté
DEFAULT_DAILY_LIMIT=40
# Fenêtre d'envoi (heure locale du serveur)
SEND_WINDOW_START=9
SEND_WINDOW_END=18
# Envoi uniquement en semaine (lundi-vendredi)
WEEKDAYS_ONLY=true
# Délai minimal / maximal (secondes) entre deux envois d'un même compte
MIN_GAP_SECONDS=90
MAX_GAP_SECONDS=420
